PROJECT_NAME="AI Document Intelligence Pipeline"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/doc_intelligence"

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"

# Local Storage
STORAGE_DIR="../storage"

# OCR Provider Configuration (tesseract | cloud)
OCR_PROVIDER="tesseract"

# LLM Configuration
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
